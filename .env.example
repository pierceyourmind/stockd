# Authentication
# Generate hash: php -r "echo password_hash('yourpassword', PASSWORD_DEFAULT) . PHP_EOL;"
AUTH_PASSWORD_HASH=

# SnapTrade API Credentials (get from https://snaptrade.com/dashboard)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# SnapTrade User Configuration
SNAPTRADE_USER_ID=stockd-user-1

# App URL (your Cloudflare Tunnel URL, needed for OAuth callback)
APP_URL=https://your-tunnel-url.trycloudflare.com
